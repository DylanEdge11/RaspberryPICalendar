# Start with demo mode. Production refuses to start without ADMIN_PIN.
APP_MODE=demo
APP_HOST=0.0.0.0
APP_PORT=8080
APP_DATA_DIR=./data
TIMEZONE=America/Regina

# Set a long, private PIN before switching to production. Do not commit .env.
# Demo mode always uses the on-page PIN 1234. Production requires this value.
# ADMIN_PIN=replace-with-a-long-private-pin

# Keep the Pi's collection bounded and image processing predictable.
MAX_PHOTOS=500
MAX_PHOTO_STORAGE_BYTES=2147483648

# Recommended Google Calendar setup: a service account. No browser sign-in, no 7-day
# expiry, no website or privacy policy. Share each calendar with the key's client_email.
# GOOGLE_SERVICE_ACCOUNT_KEY=/etc/family-calendar/service_account.json
# Comma-separated calendar IDs (your Gmail address is your main calendar's ID):
# GOOGLE_CALENDAR_IDS=you@gmail.com,family0123456789@group.calendar.google.com

# Alternative: Google Calendar OAuth configuration. Keep the client secret file outside Git.
# GOOGLE_CLIENT_SECRETS=/etc/family-calendar/client_secret.json
# For a private Pi-only OAuth setup, start the flow from the Pi's own browser:
# GOOGLE_REDIRECT_URI=http://localhost:8080/api/google/callback
# A phone-initiated flow needs an exact HTTPS callback on a domain you control.
# CALENDAR_SYNC_INTERVAL_MIN=15

# The display always follows the current date. After browsing to another week/month
# from the phone, it returns to today after this many minutes.
# AUTO_RETURN_TO_TODAY_MIN=30
